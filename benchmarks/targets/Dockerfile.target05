FROM python:3.9-slim

# Install Flask
RUN pip install --no-cache-dir flask

# Flag for WAF bypass validation
ENV FLAG_WAF_BYPASS=FLAG_WAF_BYPASS=SUCCESS

# Setup web application
RUN mkdir -p /app
COPY lab/app05.py /app/app.py
WORKDIR /app

# Expose HTTP port
EXPOSE 8080

# Start web app
CMD ["python3", "/app/app.py"]
