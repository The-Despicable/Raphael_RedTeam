      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "CAI service"
    },
    {
      "name": "mhddos-service",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "main:app",
                  "--app-dir", "src/mhddos-service", "--host", "127.0.0.1", "--port", "3301"],
      "port": 3301,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": true,
      "description": "Network stress service"
    },
    {
      "name": "phishing",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "main:app",
                  "--app-dir", "src/phishing", "--host", "127.0.0.1", "--port", "3502"],
      "port": 3502,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "Phishing infrastructure service"
