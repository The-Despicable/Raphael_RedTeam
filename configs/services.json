      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "Recon pipeline"
    },
    {
      "name": "cloak-service",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "main:app",
                  "--app-dir", "src/cloak-service", "--host", "127.0.0.1", "--port", "3401"],
      "port": 3401,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "Cloak / identity rotation"
