    {"name": "sliver-server", "binaries": ["sliver-server", "sliver/sliver-server"], "category": "c2", "required": false, "install": "manual:https://github.com/BishopFox/sliver/releases", "probe": ["sliver/sliver-server", "version"]},
    {"name": "neo4j", "binaries": ["neo4j", "data/neo4j/bin/neo4j"], "category": "graph", "required": false, "install": "manual:neo4j tarball", "probe": ["data/neo4j/bin/neo4j", "version"]},
    {"name": "caido", "binaries": ["caido"], "category": "proxy", "required": false, "install": "manual:caido-cli", "probe": ["caido", "--version"]}
