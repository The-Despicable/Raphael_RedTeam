      "port": 3600,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": true,
      "description": "Sword exploitation service"
    },
    {
      "name": "kali-tools",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "server:app",
