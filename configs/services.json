    {
      "name": "tor",
      "cwd": ".",
      "command": ["${TOR_BIN}", "-f", "${TORRC_PATH}"],
      "port": 9050,
      "secondary_port": 9052,
      "health_path": "",
      "health_kind": "tcp",
      "depends_on": [],
      "optional": true,
      "uid_guard": false,
      "description": "Tor SOCKS 9050 / control 9052"
    },
    {
      "name": "sliver-server",
      "cwd": ".",
      "command": ["sliver/sliver-server", "daemon"],
      "port": 31337,
      "secondary_port": 31334,
      "health_path": "",
      "health_kind": "tcp",
      "depends_on": [],
      "optional": true,
      "uid_guard": false,
      "description": "Sliver server"
    },
    {
      "name": "neo4j",
      "cwd": ".",
      "command": ["data/neo4j/bin/neo4j", "console"],
      "port": 7687,
      "secondary_port": 7474,
      "health_path": "",
      "health_kind": "tcp",
      "depends_on": [],
      "optional": true,
      "uid_guard": false,
      "description": "Neo4j community"
    },
    {
      "name": "caido",
      "cwd": ".",
      "command": ["caido"],
      "port": 48080,
      "health_path": "",
      "health_kind": "tcp",
      "depends_on": [],
      "optional": true,
      "uid_guard": false,
      "description": "Caido proxy"
    }
  ]
}
