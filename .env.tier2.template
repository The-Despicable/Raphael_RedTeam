# ============================================================
# TIER 2 LIVE ENGAGEMENT CREDENTIALS
# ============================================================
# DO NOT COMMIT ACTUAL VALUES TO VERSION CONTROL
# Copy to .env and fill in actual values after SENTINEL seal
# ============================================================

# GitHub Personal Access Token (PAT)
# Generate at: https://github.com/settings/tokens
# Required scopes: read:org, read:user, repo:read
# Forbidden scopes: repo, write:org, delete_repo, admin:org, etc.
GITHUB_PAT=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# HackerOne API Key (optional - for scope auto-updates only)
# Generate at: https://hackerone.com/settings/api
# NOT used for report submission - ALL reports must be manual
H1_API_KEY=h1_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============================================================
# TIER 2 RUNTIME CONFIG
# ============================================================

# Target configuration
TIER2_TARGET=github
TIER2_SCOPE_FILE=GITHUB_SCOPE_CONFIG.json
TIER2_ENGAGEMENT_SPEC=H1_GITHUB_LIVE_SPEC.json

# Rate limiter overrides for live engagement
RATE_LIMITER_JITTER_MIN_MS=10000
RATE_LIMITER_JITTER_MAX_MS=20000
RATE_LIMITER_EMERGENCY_BRAKE_THRESHOLD=0.8

# Scope parser strict mode
SCOPE_PARSER_FAIL_CLOSED=true
SCOPE_PARSER_CASE_INSENSITIVE=false

# CapabilityBroker live mode
CAPABILITY_BROKER_LIVE_MODE=true
CAPABILITY_BROKER_MAX_ACTIONS=50
CAPABILITY_BROKER_SESSION_TIMEOUT_MINUTES=60

# Safety constraints
ENABLE_MANUAL_VALIDATION_GATE=true
DISABLE_WRITE_OPERATIONS=true
MAX_ACTIONS_PER_SESSION=50
SESSION_TIMEOUT_MINUTES=60
