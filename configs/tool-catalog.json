    {"name": "ffuf", "binaries": ["ffuf"], "category": "web", "required": true, "install": "apt:ffuf", "probe": ["ffuf", "-V"]},
    {"name": "whatweb", "binaries": ["whatweb"], "category": "web", "required": true, "install": "apt:whatweb", "probe": ["whatweb", "--version"]},
    {"name": "curl", "binaries": ["curl"], "category": "web", "required": true, "install": "apt:curl", "probe": ["curl", "--version"]},
    {"name": "fping", "binaries": ["fping"], "category": "network", "required": true, "install": "apt:fping", "caps": "cap_net_raw+ep", "probe": ["fping", "-v"]},
    {"name": "smbclient", "binaries": ["smbclient"], "category": "ad", "required": true, "install": "apt:smbclient", "probe": ["smbclient", "--version"]},
    {"name": "rpcclient", "binaries": ["rpcclient"], "category": "ad", "required": true, "install": "apt:smbclient", "probe": ["rpcclient", "--version"]},
    {"name": "impacket", "binaries": ["impacket-psexec", "impacket-smbserver"], "category": "ad", "required": true, "install": "apt:impacket-scripts", "probe": ["impacket-psexec", "-h"]},
    {"name": "crackmapexec", "binaries": ["crackmapexec", "nxc"], "category": "ad", "required": true, "install": "apt:nxc", "probe": ["nxc", "--version"]},
    {"name": "bloodhound", "binaries": ["bloodhound-python"], "category": "ad", "required": true, "install": "apt:bloodhound.py", "probe": ["bloodhound-python", "--help"]},
    {"name": "secdelete", "binaries": ["srm"], "category": "antiforensics", "required": true, "install": "apt:secure-delete", "probe": ["srm", "--help"]},
    {"name": "bleachbit", "binaries": ["bleachbit"], "category": "antiforensics", "required": true, "install": "apt:bleachbit", "probe": ["bleachbit", "--version"]},
    {"name": "wipe", "binaries": ["wipe"], "category": "antiforensics", "required": true, "install": "apt:wipe", "probe": ["wipe", "-h"]},
    {"name": "sleuthkit", "binaries": ["fls", "tsk_recover"], "category": "antiforensics", "required": true, "install": "apt:sleuthkit", "probe": ["fls", "-V"]},
    {"name": "auditd", "binaries": ["auditctl"], "category": "antiforensics", "required": true, "install": "apt:auditd", "probe": ["auditctl", "--version"]},
    {"name": "shred", "binaries": ["shred"], "category": "antiforensics", "required": true, "install": "apt:coreutils", "probe": ["shred", "--version"]},
    {"name": "tor", "binaries": ["tor"], "category": "stealth", "required": true, "install": "apt:tor", "probe": ["tor", "--version"]},
    {"name": "proxychains4", "binaries": ["proxychains4"], "category": "stealth", "required": true, "install": "apt:proxychains4", "probe": ["proxychains4", "-h"]},
    {"name": "go", "binaries": ["go"], "category": "build", "required": true, "install": "apt:golang-go", "probe": ["go", "version"], "note": "needed to build tools/broadscan/bin/broadscan"},
