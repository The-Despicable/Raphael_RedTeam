{
  "$comment": "SINGLE SOURCE OF TRUTH for host services, ports, and commands. Consumed by runtime/service_registry.py, scripts/gen_env.py, scripts/native_up.sh. Do not hardcode these ports anywhere else.",
  "services": [
    {
      "name": "raphael-api",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "orchestrator.api.main:app",
                  "--app-dir", "src", "--host", "127.0.0.1", "--port", "3900"],
      "port": 3900,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": ["kali-tools", "brain"],
      "optional": false,
      "uid_guard": false,
      "description": "Integration API"
    },
    {
      "name": "brain",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "brain.main:app",
                  "--host", "127.0.0.1", "--port", "3700"],
      "port": 3700,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "Autonomous brain"
    },
    {
      "name": "c2-server",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "main:app",
                  "--app-dir", "src/c2-server", "--host", "127.0.0.1", "--port", "3501"],
      "port": 3501,
      "health_path": "/health",
      "health_kind": "http",
      "depends_on": [],
      "optional": false,
      "uid_guard": false,
      "description": "Command-and-control surface"
    },
    {
      "name": "recon-pipeline",
      "cwd": ".",
      "command": ["${RAPHAEL_PY}", "-m", "uvicorn", "main:app",
                  "--app-dir", "src/recon-pipeline", "--host", "127.0.0.1", "--port", "3503"],
